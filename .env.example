# ==============================================
# ReputeAI Environment Configuration
# ==============================================
# Copy this file to .env and update the values.
# NEVER commit .env to version control.
# ==============================================

# Database
# Development: SQLite
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL
# DATABASE_URL="postgresql://user:password@host:5432/reputeai"

# Server
PORT=3001
CLIENT_URL="http://localhost:5173"
NODE_ENV=development

# JWT Secrets — CHANGE THESE IN PRODUCTION
# Use a strong random string (e.g., openssl rand -base64 64)
JWT_SECRET=reputeai-dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=reputeai-dev-refresh-secret-change-in-production

# AI Configuration
# Options: gemini (recommended, pay-per-use), groq (cloud, free tier), ollama (local), template (no AI)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash

# Gemini API Key (required when AI_PROVIDER=gemini)
# Get your key at https://aistudio.google.com/apikey
# Pay-per-use: ~$0.10/1M input tokens — no monthly fee
GEMINI_API_KEY=

# Groq API Key (required when AI_PROVIDER=groq)
# Get free key at https://console.groq.com
# When using Groq, set: AI_PROVIDER=groq, AI_MODEL=llama-3.1-8b-instant, AI_BASE_URL=https://api.groq.com/openai/v1
AI_BASE_URL=http://localhost:11434
GROQ_API_KEY=

# Google Business Profile OAuth (optional)
# Leave empty to disable Google integration.
# To enable: create OAuth credentials at https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
